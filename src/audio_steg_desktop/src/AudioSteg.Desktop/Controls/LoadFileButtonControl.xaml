<UserControl x:Class="AudioSteg.Desktop.Controls.LoadFileButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel HorizontalAlignment="Center">
    <Grid Width="130" Height="130">
      <Button x:Name="MainButton" Width="96" Height="96" Click="MainButton_Click"
              HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" Cursor="Hand">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Square" Width="96" Height="96" CornerRadius="18"
                    Background="{TemplateBinding Background}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.35" Color="#40000000" />
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Button.Template>
        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="White" Text="&#xE8E5;" />
      </Button>
    </Grid>
    <TextBlock x:Name="LabelText" Margin="0,8,0,0" HorizontalAlignment="Center"
               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
  </StackPanel>
</UserControl>
