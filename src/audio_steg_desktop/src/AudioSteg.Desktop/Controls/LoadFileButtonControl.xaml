<UserControl x:Class="AudioSteg.Desktop.Controls.LoadFileButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel HorizontalAlignment="Center">
    <Grid Width="65" Height="65">
      <Button x:Name="MainButton" Width="48" Height="48" Click="MainButton_Click"
              HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" Cursor="Hand">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Square" Width="48" Height="48" CornerRadius="9"
                    Background="{TemplateBinding Background}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="9" ShadowDepth="3" Opacity="0.35" Color="#40000000" />
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Button.Template>
        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" Text="&#xE8E5;" />
      </Button>
    </Grid>
    <TextBlock x:Name="LabelText" Margin="0,4,0,0" HorizontalAlignment="Center"
               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
  </StackPanel>
</UserControl>
