<Window x:Class="AudioSteg.Desktop.Dialogs.RecoveryBitsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">
  <Border Padding="24" CornerRadius="16">
    <StackPanel>
      <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"
                 Margin="0,0,0,12" />
      <TextBlock x:Name="MessageText" Style="{StaticResource BodySmall}" TextWrapping="Wrap"
                 Margin="0,0,0,16" />
      <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="12" Padding="16,12">
        <StackPanel>
          <TextBlock x:Name="ValueLabel" Style="{StaticResource BodySmall}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="BitsValueText" FontSize="32" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource OnSurfaceBrush}" />
            <Button x:Name="CopyButton" Style="{StaticResource TonalButton}" Margin="12,0,0,0"
                    Padding="10" ToolTipService.ToolTip="" Click="CopyButton_Click">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="20" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="CapacityHintText" Style="{StaticResource BodySmall}" TextWrapping="Wrap"
                 Margin="0,12,0,0" Opacity="0.85" />
      <TextBlock x:Name="CopiedHint" Style="{StaticResource BodySmall}" TextAlignment="Center"
                 Margin="0,8,0,0" Visibility="Collapsed"
                 Foreground="{DynamicResource SuccessBrush}" />
      <Button x:Name="OkButton" Style="{StaticResource FilledButton}" Margin="0,20,0,0"
              MinWidth="120" HorizontalAlignment="Stretch" Click="OkButton_Click" />
    </StackPanel>
  </Border>
</Window>
