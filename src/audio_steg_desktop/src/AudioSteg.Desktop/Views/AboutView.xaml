<UserControl x:Class="AudioSteg.Desktop.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
    <StackPanel MaxWidth="720">
      <Border Style="{StaticResource MaterialCard}" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True"
                    Background="{DynamicResource PrimaryContainerBrush}">
              <Image x:Name="ProfilePhoto" Stretch="UniformToFill" />
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="ProfileTitle" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="ThesisLine" Style="{StaticResource BodySmall}" Margin="0,4,0,0"
                         Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              <TextBlock x:Name="VersionLine" Style="{StaticResource BodySmall}" Margin="0,6,0,0"
                         Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="BioText" Style="{StaticResource BodySmall}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource MaterialCard}" Padding="12,12,12,4" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock x:Name="SupervisorTitle" Style="{StaticResource SectionTitle}" Margin="12,0,0,8" />
          <StackPanel x:Name="SupervisorPanel" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource MaterialCard}" Padding="12,12,12,4" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock x:Name="LinksTitle" Style="{StaticResource SectionTitle}" Margin="12,0,0,8" />
          <StackPanel x:Name="LinksPanel" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource MaterialCard}" Padding="12,12,12,4" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock x:Name="ContactTitle" Style="{StaticResource SectionTitle}" Margin="12,0,0,8" />
          <StackPanel x:Name="ContactPanel" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource MaterialCard}" Padding="16">
        <StackPanel>
          <TextBlock x:Name="AlgoTitle" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,8" />
          <TextBlock x:Name="AlgoBody" Style="{StaticResource BodySmall}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
