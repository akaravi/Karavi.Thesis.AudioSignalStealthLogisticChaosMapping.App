<UserControl x:Class="AudioSteg.Desktop.Views.EmbedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
    <StackPanel MaxWidth="720">
      <TextBox x:Name="MessageTextBox" AcceptsReturn="True" TextWrapping="Wrap"
               MinHeight="100" VerticalScrollBarVisibility="Auto" />
      <Border Margin="0,16,0,0" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
        <StackPanel>
          <Border x:Name="WaveformBar" Height="48" CornerRadius="8" Margin="0,0,0,16"
                  Background="{StaticResource BorderBrush}" />
          <Button x:Name="RecordButton" HorizontalAlignment="Stretch" Height="44"
                  Click="RecordButton_Click" />
          <ProgressBar x:Name="BusyBar" Height="4" Margin="0,12,0,0" IsIndeterminate="True"
                       Visibility="Collapsed" />
          <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedBrush}" FontSize="13" />
        </StackPanel>
      </Border>
      <Border x:Name="ResultPanel" Margin="0,16,0,0" Visibility="Collapsed"
              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}"
              BorderThickness="1" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock x:Name="ResultTitle" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
          <TextBlock x:Name="MetricsText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                     Margin="0,0,0,12" />
          <WrapPanel>
            <Button x:Name="PlayButton" Margin="0,0,8,8" Click="PlayButton_Click" />
            <Button x:Name="SaveButton" Margin="0,0,8,8" Click="SaveButton_Click" />
            <Button x:Name="VerifyButton" Margin="0,0,8,8" Click="VerifyButton_Click" />
          </WrapPanel>
          <TextBlock x:Name="VerifyText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
