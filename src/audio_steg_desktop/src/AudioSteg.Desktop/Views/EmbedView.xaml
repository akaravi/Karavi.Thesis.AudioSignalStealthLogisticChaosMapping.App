<UserControl x:Class="AudioSteg.Desktop.Views.EmbedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioSteg.Desktop.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
    <StackPanel MaxWidth="720">
      <TextBox x:Name="MessageTextBox" Style="{StaticResource MaterialTextBox}"
               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
               VerticalScrollBarVisibility="Auto" />

      <Border Style="{StaticResource MaterialCard}" Margin="0,16,0,0" Padding="12,16">
        <StackPanel>
          <TextBlock x:Name="EqualizerTitle" Style="{StaticResource BodySmall}" Margin="0,0,0,6" />
          <controls:EqualizerControl x:Name="Equalizer" />
          <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:RecordButtonControl x:Name="RecordBtn" Grid.Column="0" HorizontalAlignment="Center" />
            <Button x:Name="LoadFileBtn" Grid.Column="2" Style="{StaticResource TonalButton}"
                    MinWidth="110" Margin="0,28,0,0" VerticalAlignment="Top"
                    Click="LoadFileBtn_Click">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="28"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadFileLabel" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,6,0,0" MaxWidth="120" />
              </StackPanel>
            </Button>
          </Grid>
          <ProgressBar x:Name="BusyBar" Height="22" Width="22" Margin="0,12,0,0"
                       HorizontalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
          <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextAlignment="Center"
                     Style="{StaticResource BodySmall}" />
        </StackPanel>
      </Border>

      <Border x:Name="ResultPanel" Style="{StaticResource ResultCard}" Margin="0,16,0,0"
              Visibility="Collapsed" Padding="16">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="20"
                       Foreground="{DynamicResource OnPrimaryContainerBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="ResultTitle" Margin="8,0,0,0" Style="{StaticResource SectionTitle}"
                       Foreground="{DynamicResource OnPrimaryContainerBrush}" />
          </StackPanel>
          <TextBlock x:Name="CompareChartTitle" Style="{StaticResource SectionTitle}" FontSize="14"
                     Foreground="{DynamicResource OnPrimaryContainerBrush}" Margin="0,0,0,8" />
          <controls:DualWaveformControl x:Name="CompareChart" Margin="0,0,0,12" />
          <TextBlock x:Name="MetricsTitle" Style="{StaticResource SectionTitle}" FontSize="14"
                     Foreground="{DynamicResource OnPrimaryContainerBrush}" Margin="0,0,0,8" />
          <ItemsControl x:Name="MetricsItems" ItemTemplate="{StaticResource MetricChipTemplate}" />
          <WrapPanel Margin="0,12,0,0">
            <Button x:Name="PlayButton" Style="{StaticResource FilledButton}" Margin="0,0,8,8"
                    Click="PlayButton_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,8,0" />
                <TextBlock x:Name="PlayLabel" />
              </StackPanel>
            </Button>
            <Button x:Name="PauseButton" Style="{StaticResource TonalButton}" Margin="0,0,8,8"
                    Click="PauseButton_Click" IsEnabled="False">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;" Margin="0,0,8,0" />
                <TextBlock x:Name="PauseLabel" />
              </StackPanel>
            </Button>
            <Button x:Name="StopPlaybackButton" Style="{StaticResource TonalButton}" Margin="0,0,8,8"
                    Click="StopPlaybackButton_Click" IsEnabled="False">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" Margin="0,0,8,0" />
                <TextBlock x:Name="StopPlaybackLabel" />
              </StackPanel>
            </Button>
            <Button x:Name="SaveButton" Style="{StaticResource TonalButton}" Margin="0,0,8,8"
                    Click="SaveButton_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,8,0" />
                <TextBlock x:Name="SaveLabel" />
              </StackPanel>
            </Button>
            <Button x:Name="VerifyButton" Style="{StaticResource TonalButton}" Margin="0,0,8,8"
                    Click="VerifyButton_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="VerifyIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Margin="0,0,8,0" />
                <TextBlock x:Name="VerifyLabel" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <Border x:Name="VerifyBanner" Margin="0,12,0,0" CornerRadius="12" Padding="12"
                  Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="VerifyBannerIcon" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,8,0" />
              <TextBlock x:Name="VerifyText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
