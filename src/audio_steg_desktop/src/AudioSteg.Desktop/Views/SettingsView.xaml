<UserControl x:Class="AudioSteg.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
    <StackPanel MaxWidth="560">
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock x:Name="ThemeLabel" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock x:Name="LogisticLabel" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock x:Name="RLabel" />
          <Slider x:Name="RSlider" Minimum="3.5" Maximum="4.0" TickFrequency="0.01"
                  IsSnapToTickEnabled="True" ValueChanged="RSlider_ValueChanged" />
          <TextBlock x:Name="RValueText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
          <TextBlock x:Name="X0Label" />
          <Slider x:Name="X0Slider" Minimum="0.01" Maximum="0.99" TickFrequency="0.01"
                  IsSnapToTickEnabled="True" ValueChanged="X0Slider_ValueChanged" />
          <TextBlock x:Name="X0ValueText" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </Border>
      <Button x:Name="ResetButton" HorizontalAlignment="Center" Click="ResetButton_Click" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
