<UserControl x:Class="AudioSteg.Desktop.Views.ExtractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
    <StackPanel MaxWidth="720">
      <Border Style="{StaticResource MaterialCard}" Padding="20">
        <StackPanel>
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E6;" FontSize="56"
                     Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
          <TextBlock x:Name="PickTitle" Style="{StaticResource SectionTitle}"
                     HorizontalAlignment="Center" Margin="0,12,0,16" TextAlignment="Center" />
          <TextBox x:Name="BitLengthBox" Style="{StaticResource MaterialTextBox}" />
          <TextBlock x:Name="BitLengthHelper" Style="{StaticResource BodySmall}" Margin="0,8,0,16" />
          <Button x:Name="PickButton" Style="{StaticResource FilledButton}" Click="PickButton_Click"
                  HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock x:Name="PickIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE838;" Margin="0,0,8,0" />
              <TextBlock x:Name="PickLabel" />
            </StackPanel>
          </Button>
          <ProgressBar x:Name="BusyBar" Height="22" Width="22" Margin="0,12,0,0"
                       HorizontalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
          <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextAlignment="Center"
                     Style="{StaticResource BodySmall}" />
        </StackPanel>
      </Border>

      <Border x:Name="ResultPanel" Style="{StaticResource ResultCard}" Margin="0,16,0,0"
              Visibility="Collapsed" Padding="16">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="ResultHeaderIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="20"
                       Foreground="{DynamicResource OnPrimaryContainerBrush}" />
            <TextBlock x:Name="ResultTitle" Margin="8,0,0,0" Style="{StaticResource SectionTitle}"
                       Foreground="{DynamicResource OnPrimaryContainerBrush}" />
          </StackPanel>
          <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80"
                   Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource OnPrimaryContainerBrush}" FontSize="15" />
          <Button x:Name="CopyButton" Style="{StaticResource TonalButton}" HorizontalAlignment="Right"
                  Margin="0,12,0,0" Click="CopyButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" Margin="0,0,8,0" />
              <TextBlock x:Name="CopyLabel" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
