<UserControl x:Class="AudioSteg.Desktop.Views.ExtractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
    <StackPanel MaxWidth="720">
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="12" Padding="20">
        <StackPanel>
          <TextBlock x:Name="PickTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16" />
          <TextBox x:Name="BitLengthBox" Margin="0,0,0,8" />
          <TextBlock x:Name="BitLengthHelper" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                     FontSize="12" Margin="0,0,0,16" />
          <Button x:Name="PickButton" Height="40" Click="PickButton_Click" />
          <ProgressBar x:Name="BusyBar" Height="4" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" />
          <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedBrush}" FontSize="13" />
        </StackPanel>
      </Border>
      <Border x:Name="ResultPanel" Margin="0,16,0,0" Visibility="Collapsed"
              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock x:Name="ResultTitle" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
          <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80"
                   BorderThickness="0" Background="Transparent" />
          <Button x:Name="CopyButton" HorizontalAlignment="Right" Margin="0,12,0,0" Click="CopyButton_Click" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
