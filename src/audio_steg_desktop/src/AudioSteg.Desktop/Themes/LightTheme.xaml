<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgColor">#FFFFFBFE</Color>
  <Color x:Key="SurfaceColor">#FFFFFBFE</Color>
  <Color x:Key="SurfaceVariantColor">#FFE7E0EC</Color>
  <Color x:Key="TextColor">#FF1C1B1F</Color>
  <Color x:Key="MutedColor">#FF49454F</Color>
  <Color x:Key="BorderColor">#FFCAC4D0</Color>
  <Color x:Key="PrimaryColor">#FF6750A4</Color>
  <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
  <Color x:Key="PrimaryContainerColor">#FFEADDFF</Color>
  <Color x:Key="OnPrimaryContainerColor">#FF21005D</Color>
  <Color x:Key="SecondaryContainerColor">#FFE8DEF8</Color>
  <Color x:Key="ErrorColor">#FFB3261E</Color>
  <Color x:Key="OnErrorContainerColor">#FF410E0B</Color>
  <Color x:Key="ErrorContainerColor">#FFF9DEDC</Color>
  <Color x:Key="SuccessColor">#FF2E7D32</Color>
  <Color x:Key="NavIndicatorColor">#FFE8DEF8</Color>
  <Color x:Key="ChartStegoColor">#FF006874</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
  <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
  <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />
  <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainerColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="NavIndicatorBrush" Color="{StaticResource NavIndicatorColor}" />
  <SolidColorBrush x:Key="ChartStegoBrush" Color="{StaticResource ChartStegoColor}" />
</ResourceDictionary>
