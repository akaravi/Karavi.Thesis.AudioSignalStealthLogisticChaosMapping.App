<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgColor">#FF1C1B1F</Color>
  <Color x:Key="SurfaceColor">#FF1C1B1F</Color>
  <Color x:Key="SurfaceVariantColor">#FF49454F</Color>
  <Color x:Key="TextColor">#FFE6E1E5</Color>
  <Color x:Key="MutedColor">#FFCAC4D0</Color>
  <Color x:Key="BorderColor">#FF49454F</Color>
  <Color x:Key="PrimaryColor">#FFD0BCFF</Color>
  <Color x:Key="OnPrimaryColor">#FF381E72</Color>
  <Color x:Key="PrimaryContainerColor">#FF4F378B</Color>
  <Color x:Key="OnPrimaryContainerColor">#FFEADDFF</Color>
  <Color x:Key="SecondaryContainerColor">#FF4A4458</Color>
  <Color x:Key="ErrorColor">#FFF2B8B5</Color>
  <Color x:Key="OnErrorContainerColor">#FFF9DEDC</Color>
  <Color x:Key="ErrorContainerColor">#FF8C1D18</Color>
  <Color x:Key="SuccessColor">#FF81C784</Color>
  <Color x:Key="NavIndicatorColor">#FF4A4458</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
  <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
  <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />
  <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainerColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="NavIndicatorBrush" Color="{StaticResource NavIndicatorColor}" />
</ResourceDictionary>
