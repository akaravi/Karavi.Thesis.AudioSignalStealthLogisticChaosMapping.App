<UserControl x:Class="AudioStegano.Desktop.Views.EmbedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioStegano.Desktop.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
    <StackPanel MaxWidth="720">
      <StackPanel x:Name="EmbedInputPanel">
        <TextBox x:Name="MessageTextBox" Style="{StaticResource MaterialTextBox}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="MessageTextBox_TextChanged" />
        <TextBlock x:Name="MessageBitsCounter" Style="{StaticResource BodySmall}"
                   Margin="0,6,0,0" HorizontalAlignment="Right" TextAlignment="Right" />

        <Border Style="{StaticResource MaterialCard}" Margin="0,16,0,0" Padding="12,16">
        <StackPanel>
          <TextBlock x:Name="EqualizerTitle" Style="{StaticResource BodySmall}" Margin="0,0,0,6" />
          <controls:EqualizerControl x:Name="Equalizer" />
          <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:RecordButtonControl x:Name="RecordBtn" Grid.Column="0" HorizontalAlignment="Center" />
            <controls:LoadFileButtonControl x:Name="LoadFileBtn" Grid.Column="2"
                                            HorizontalAlignment="Center" />
          </Grid>
          <ProgressBar x:Name="BusyBar" Height="22" Width="22" Margin="0,12,0,0"
                       HorizontalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
          <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextAlignment="Center"
                     Style="{StaticResource BodySmall}" />
        </StackPanel>
        </Border>
      </StackPanel>

      <Border x:Name="ResultPanel" Style="{StaticResource ResultCard}" Margin="0,16,0,0"
              Visibility="Collapsed" Padding="16">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="20"
                       Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="ResultTitle" Margin="8,0,0,0" Style="{StaticResource SectionTitle}"
                       Foreground="{DynamicResource TextBrush}" />
          </StackPanel>
          <WrapPanel Margin="0,0,0,12">
            <Button x:Name="PlayButton" Style="{StaticResource IconFilledButton}" Margin="0,0,8,8"
                    Click="PlayButton_Click">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="16" />
            </Button>
            <Button x:Name="PauseButton" Style="{StaticResource IconTonalButton}" Margin="0,0,8,8"
                    Click="PauseButton_Click" IsEnabled="False">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="16" />
            </Button>
            <Button x:Name="StopPlaybackButton" Style="{StaticResource IconTonalButton}" Margin="0,0,8,8"
                    Click="StopPlaybackButton_Click" IsEnabled="False">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="16" />
            </Button>
            <Button x:Name="SaveButton" Style="{StaticResource TonalButton}" Margin="0,0,8,8"
                    Click="SaveButton_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,8,0" />
                <TextBlock x:Name="SaveLabel" />
              </StackPanel>
            </Button>
            <Button x:Name="VerifyButton" Style="{StaticResource TonalButton}" Margin="0,0,8,8"
                    Click="VerifyButton_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="VerifyIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Margin="0,0,8,0" />
                <TextBlock x:Name="VerifyLabel" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <Border x:Name="VerifyBanner" Margin="0,0,0,12" CornerRadius="12" Padding="12"
                  Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="VerifyBannerIcon" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,8,0" />
              <TextBlock x:Name="VerifyText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="16" Padding="12"
                  Margin="0,0,0,0">
            <StackPanel>
              <TextBlock x:Name="CompareChartTitle" Style="{StaticResource SectionTitle}" FontSize="14"
                         Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
              <controls:DualWaveformControl x:Name="CompareChart" Margin="0,0,0,12" />
              <TextBlock x:Name="MetricsTitle" Style="{StaticResource SectionTitle}" FontSize="14"
                         Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
              <ItemsControl x:Name="MetricsItems" ItemTemplate="{StaticResource MetricChipTemplate}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
