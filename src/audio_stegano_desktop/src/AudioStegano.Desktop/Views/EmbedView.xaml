<UserControl x:Class="AudioStegano.Desktop.Views.EmbedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioStegano.Desktop.Controls">
  <Grid>
    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" Padding="16,48,16,16">
      <StackPanel MaxWidth="720">
      <StackPanel x:Name="EmbedInputPanel">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <RadioButton x:Name="PayloadModeText" GroupName="EmbedPayloadMode" IsChecked="True"
                       Margin="0,0,16,0" Checked="PayloadMode_Checked" />
          <RadioButton x:Name="PayloadModeAudio" GroupName="EmbedPayloadMode"
                       Margin="0,0,16,0" Checked="PayloadMode_Checked" />
          <RadioButton x:Name="PayloadModeImage" GroupName="EmbedPayloadMode"
                       Checked="PayloadMode_Checked" />
        </StackPanel>
        <StackPanel x:Name="TextPayloadPanel">
          <TextBlock x:Name="MessageLabel" Style="{StaticResource BodySmall}" Margin="0,0,0,6"
                     Foreground="{DynamicResource TextBrush}" />
          <TextBox x:Name="MessageTextBox" Style="{StaticResource MaterialTextBox}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                   VerticalScrollBarVisibility="Auto"
                   TextChanged="MessageTextBox_TextChanged" />
          <TextBlock x:Name="MessageBitsCounter" Style="{StaticResource BodySmall}"
                     TextWrapping="Wrap" Margin="0,6,0,0" HorizontalAlignment="Right" TextAlignment="Right" />
        </StackPanel>
        <StackPanel x:Name="AudioPayloadPanel" Visibility="Collapsed">
          <TextBlock x:Name="AudioPayloadHint" Style="{StaticResource BodySmall}"
                     TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock x:Name="AudioPayloadBudget" Style="{StaticResource BodySmall}"
                     TextWrapping="Wrap" Margin="0,0,0,8" />
          <Button x:Name="ClearPayloadAudioBtn" Style="{StaticResource TonalButton}"
                  HorizontalAlignment="Right" Margin="0,0,0,8" Click="ClearPayloadAudio_Click"
                  Visibility="Collapsed">
            <TextBlock x:Name="ClearPayloadAudioLabel" />
          </Button>
        </StackPanel>
        <StackPanel x:Name="ImagePayloadPanel" Visibility="Collapsed">
          <TextBlock x:Name="ImagePayloadHint" Style="{StaticResource BodySmall}"
                     TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock x:Name="ImagePayloadBudget" Style="{StaticResource BodySmall}"
                     TextWrapping="Wrap" Margin="0,0,0,8" />
          <Image x:Name="PayloadImagePreview" MaxHeight="140" Stretch="Uniform"
                 Margin="0,0,0,8" Visibility="Collapsed" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PickPayloadImageBtn" Style="{StaticResource TonalButton}"
                    Margin="0,0,8,8" Click="PickPayloadImage_Click">
              <TextBlock x:Name="PickPayloadImageLabel" />
            </Button>
            <Button x:Name="ClearPayloadImageBtn" Style="{StaticResource TonalButton}"
                    Margin="0,0,0,8" Click="ClearPayloadImage_Click"
                    Visibility="Collapsed">
              <TextBlock x:Name="ClearPayloadImageLabel" />
            </Button>
          </StackPanel>
        </StackPanel>

        <Border x:Name="AudioSourceCard" Style="{StaticResource MaterialCard}" Margin="0,16,0,0" Padding="12,16">
          <StackPanel>
            <TextBlock x:Name="EqualizerTitle" Style="{StaticResource BodySmall}" Margin="0,0,0,6" />
            <controls:EqualizerControl x:Name="Equalizer" />
            <StackPanel x:Name="CoverMinProgressPanel" Margin="0,10,0,0" Visibility="Collapsed">
              <ProgressBar x:Name="CoverMinProgressBar" Height="10" Minimum="0" Maximum="1"
                           Value="0" />
              <TextBlock x:Name="CoverMinProgressText" Margin="0,6,0,0" TextAlignment="Center"
                         Style="{StaticResource BodySmall}" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:RecordButtonControl x:Name="RecordBtn" Grid.Column="0" HorizontalAlignment="Center" />
              <TextBlock x:Name="AudioSourceOrLabel" Grid.Column="1" VerticalAlignment="Center"
                         Margin="8,0" Style="{StaticResource BodySmall}" Visibility="Collapsed" />
              <controls:LoadFileButtonControl x:Name="LoadFileBtn" Grid.Column="2"
                                              HorizontalAlignment="Center" />
            </Grid>
              <ProgressBar x:Name="BusyBar" Height="22" Width="22" Margin="0,12,0,0"
                           HorizontalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
              <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextAlignment="Center"
                         Style="{StaticResource BodySmall}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Border x:Name="ResultPanel" Style="{StaticResource ResultCard}" Margin="0,16,0,0"
                Visibility="Collapsed" Padding="20">
          <StackPanel>
            <!-- Hero success -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="32"
                         Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"
                         Opacity="0.92" />
              <TextBlock x:Name="ResultTitle" Margin="0,8,0,0" Style="{StaticResource SectionTitle}"
                         FontSize="17" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                         HorizontalAlignment="Center" TextWrapping="Wrap" />
              <TextBlock x:Name="ResultSubtitle" Margin="0,4,0,0" Style="{StaticResource BodySmall}"
                         Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"
                         HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
            </StackPanel>

            <!-- Primary CTAs — icon toolbar -->
            <WrapPanel Margin="0,0,0,16" HorizontalAlignment="Center">
              <Button x:Name="SaveButton" Style="{StaticResource IconFilledButton}" Margin="0,0,8,8"
                      Background="{DynamicResource IconSaveBrush}"
                      Foreground="{DynamicResource OnPrimaryBrush}"
                      Click="SaveButton_Click" ToolTipService.ShowOnDisabled="True">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="16" />
              </Button>
              <Button x:Name="ShareButton" Style="{StaticResource IconTonalButton}" Margin="0,0,8,8"
                      Background="{DynamicResource IconShareContainerBrush}"
                      Foreground="{DynamicResource IconShareBrush}"
                      Click="ShareButton_Click" ToolTipService.ShowOnDisabled="True">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72D;" FontSize="16"
                           Foreground="{DynamicResource IconShareBrush}" />
              </Button>
              <Button x:Name="VerifyButton" Style="{StaticResource IconTonalButton}" Margin="0,0,8,8"
                      Background="{DynamicResource IconVerifyContainerBrush}"
                      Foreground="{DynamicResource IconVerifyBrush}"
                      Click="VerifyButton_Click" ToolTipService.ShowOnDisabled="True">
                <Grid>
                  <TextBlock x:Name="VerifyIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="16"
                             Foreground="{DynamicResource IconVerifyBrush}" />
                  <ProgressBar x:Name="VerifyProgress" Width="16" Height="16" IsIndeterminate="True"
                               Visibility="Collapsed" />
                </Grid>
              </Button>
              <Button x:Name="CopyMessageButton" Style="{StaticResource IconTonalButton}" Margin="0,0,8,8"
                      Background="{DynamicResource IconCopyContainerBrush}"
                      Foreground="{DynamicResource IconCopyBrush}"
                      Click="CopyMessageButton_Click" ToolTipService.ShowOnDisabled="True">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="16"
                           Foreground="{DynamicResource IconCopyBrush}" />
              </Button>
            </WrapPanel>

            <Border x:Name="VerifyBanner" Margin="0,0,0,16" CornerRadius="12" Padding="12,10"
                    Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="VerifyBannerIcon" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.9" />
                <TextBlock x:Name="VerifyText" TextWrapping="Wrap" VerticalAlignment="Center"
                           FontSize="12.5" LineHeight="18" />
              </StackPanel>
            </Border>

            <Border x:Name="AbListenPanel" Margin="0,0,0,16" CornerRadius="14" Padding="12"
                    Background="{DynamicResource SurfaceVariantBrush}" Visibility="Collapsed"
                    Opacity="0.95">
              <StackPanel>
                <TextBlock x:Name="AbListenTitle" Style="{StaticResource BodySmall}" FontSize="13"
                           FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,10" />
                <Grid x:Name="AbListenCompareGrid" SizeChanged="AbListenCompareGrid_SizeChanged">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="AbListenCol0" Width="*" />
                    <ColumnDefinition x:Name="AbListenColGap" Width="8" />
                    <ColumnDefinition x:Name="AbListenCol1" Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="AbListenRowGap" Height="0" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Border x:Name="AbListenOriginalCard" Grid.Column="0" Grid.Row="0" CornerRadius="12"
                          Padding="10,8" Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DockPanel LastChildFill="True">
                      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="PauseCoverButton" Style="{StaticResource IconTonalButton}"
                                Click="PauseCoverButton_Click" Visibility="Collapsed" Margin="0,0,4,0"
                                ToolTipService.ShowOnDisabled="True">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="16" />
                        </Button>
                        <Button x:Name="StopCoverButton" Style="{StaticResource IconTonalButton}"
                                Click="StopCoverButton_Click" Visibility="Collapsed" Margin="0,0,8,0"
                                ToolTipService.ShowOnDisabled="True">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="16" />
                        </Button>
                        <Button x:Name="PlayCoverButton" Style="{StaticResource IconTonalButton}"
                                Click="PlayCoverButton_Click"
                                ToolTipService.ShowOnDisabled="True">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="16" />
                        </Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource SecondaryContainerBrush}">
                          <TextBlock Text="A" FontWeight="SemiBold" FontSize="11"
                                     Foreground="{DynamicResource OnPrimaryContainerBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FlowDirection="LeftToRight" />
                        </Border>
                        <TextBlock x:Name="AbListenOriginalSideTitle" Margin="8,0,0,0"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <Border x:Name="AbListenStegoCard" Grid.Column="2" Grid.Row="0" CornerRadius="12"
                          Padding="10,8" Background="{DynamicResource PrimaryContainerBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DockPanel LastChildFill="True">
                      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="PauseStegoButton" Style="{StaticResource IconTonalButton}"
                                Click="PauseStegoButton_Click" Visibility="Collapsed" Margin="0,0,4,0"
                                ToolTipService.ShowOnDisabled="True">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="16" />
                        </Button>
                        <Button x:Name="StopStegoButton" Style="{StaticResource IconTonalButton}"
                                Click="StopStegoButton_Click" Visibility="Collapsed" Margin="0,0,8,0"
                                ToolTipService.ShowOnDisabled="True">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="16" />
                        </Button>
                        <Button x:Name="PlayStegoButton" Style="{StaticResource IconFilledButton}"
                                Click="PlayStegoButton_Click"
                                ToolTipService.ShowOnDisabled="True">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="16" />
                        </Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource PrimaryBrush}">
                          <TextBlock Text="B" FontWeight="SemiBold" FontSize="11"
                                     Foreground="{DynamicResource OnPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FlowDirection="LeftToRight" />
                        </Border>
                        <TextBlock x:Name="AbListenStegoSideTitle" Margin="8,0,0,0"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <Border x:Name="RecoveredPayloadPanel" Margin="0,0,0,16" CornerRadius="14" Padding="12"
                    Background="{DynamicResource SurfaceVariantBrush}" Visibility="Collapsed"
                    Opacity="0.95">
              <StackPanel>
                <TextBlock x:Name="RecoveredPayloadTitle" Style="{StaticResource BodySmall}" FontSize="13"
                           FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                           Margin="0,0,0,10" />
                <Grid x:Name="RecoveredCompareGrid" SizeChanged="RecoveredCompareGrid_SizeChanged">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RecoveredCompareCol0" Width="*" />
                    <ColumnDefinition x:Name="RecoveredCompareColGap" Width="12" />
                    <ColumnDefinition x:Name="RecoveredCompareCol1" Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="RecoveredCompareRowGap" Height="0" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel x:Name="OriginalPayloadColumn" Grid.Column="0" Grid.Row="0">
                    <TextBlock x:Name="OriginalPayloadHeading" Style="{StaticResource BodySmall}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="OriginalTextBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="64"
                             Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                             Foreground="{DynamicResource TextBrush}" FontSize="14" />
                    <Image x:Name="OriginalImage" MaxHeight="160" Stretch="Uniform" Margin="0,0,0,8"
                           Visibility="Collapsed" />
                    <WrapPanel>
                      <Button x:Name="PlayOriginalPayloadButton" Style="{StaticResource IconTonalButton}"
                              Margin="0,0,8,0" Click="PlayOriginalPayloadButton_Click" Visibility="Collapsed"
                              ToolTipService.ShowOnDisabled="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="16" />
                      </Button>
                      <Button x:Name="CopyOriginalButton" Style="{StaticResource IconTonalButton}"
                              Click="CopyOriginalButton_Click" Visibility="Collapsed"
                              ToolTipService.ShowOnDisabled="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="16" />
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                  <StackPanel x:Name="RecoveredPayloadColumn" Grid.Column="2" Grid.Row="0">
                    <TextBlock x:Name="RecoveredPayloadHeading" Style="{StaticResource BodySmall}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="RecoveredTextBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="64"
                             Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                             Foreground="{DynamicResource TextBrush}" FontSize="14" />
                    <Image x:Name="RecoveredImage" MaxHeight="160" Stretch="Uniform" Margin="0,0,0,8"
                           Visibility="Collapsed" />
                    <WrapPanel>
                      <Button x:Name="PlayRecoveredButton" Style="{StaticResource IconTonalButton}" Margin="0,0,8,0"
                              Click="PlayRecoveredButton_Click" Visibility="Collapsed"
                              ToolTipService.ShowOnDisabled="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="16" />
                      </Button>
                      <Button x:Name="SaveRecoveredButton" Style="{StaticResource IconTonalButton}" Margin="0,0,8,0"
                              Click="SaveRecoveredButton_Click" Visibility="Collapsed"
                              ToolTipService.ShowOnDisabled="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="16" />
                      </Button>
                      <Button x:Name="CopyRecoveredButton" Style="{StaticResource IconTonalButton}"
                              Click="CopyRecoveredButton_Click" Visibility="Collapsed"
                              ToolTipService.ShowOnDisabled="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="16" />
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="14" Padding="12"
                    Opacity="0.95">
              <StackPanel>
                <TextBlock x:Name="AnalysisSectionTitle" Style="{StaticResource BodySmall}" FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
                <TextBlock x:Name="CompareChartTitle" Style="{StaticResource BodySmall}" FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                <controls:DualWaveformControl x:Name="CompareChart" Margin="0,0,0,14" />
                <TextBlock x:Name="MetricsTitle" Style="{StaticResource BodySmall}" FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                <TextBlock x:Name="MetricsTapHint" Style="{StaticResource BodySmall}"
                           Margin="0,0,0,8" />
                <ItemsControl x:Name="MetricsItems" ItemTemplate="{StaticResource MetricChipTemplate}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="16,8,16,0">
      <Button x:Name="NewEmbedFab" Style="{StaticResource CircleFabPrimary}" Margin="0,0,8,0"
              Click="NewEmbedFab_Click" ToolTipService.ShowOnDisabled="True">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70B;" FontSize="18" />
      </Button>
      <Button x:Name="HelpFab" Style="{StaticResource CircleFabSecondary}"
              Click="HelpFab_Click" ToolTipService.ShowOnDisabled="True">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE897;" FontSize="18" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
