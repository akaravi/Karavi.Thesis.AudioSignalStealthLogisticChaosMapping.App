<UserControl x:Class="AudioStegano.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioStegano.Desktop.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
    <StackPanel MaxWidth="560">
      <Border Style="{StaticResource MaterialCard}" Margin="0,0,0,10" Padding="10,10,10,10">
        <StackPanel>
          <TextBlock x:Name="ThemeLabel" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
          <UniformGrid x:Name="ThemeSegments" Rows="1" Columns="3" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource MaterialCard}" Margin="0,0,0,10" Padding="10,10,10,10">
        <StackPanel>
          <TextBlock x:Name="LanguageLabel" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
          <UniformGrid x:Name="LanguageSegments" Rows="2" Columns="2" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource MaterialCard}" Margin="0,0,0,10" Padding="10,10,10,10">
        <StackPanel>
          <TextBlock x:Name="ColorSeedLabel" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
          <WrapPanel x:Name="ColorSeedPanel" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource MaterialCard}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock x:Name="LogisticLabel" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
          <controls:LogisticMapPreviewControl x:Name="LogisticPreview" Margin="0,0,0,16" />
          <TextBlock x:Name="RLabel" Foreground="{DynamicResource TextBrush}" />
          <TextBlock x:Name="RRangeHint" Style="{StaticResource BodySmall}" Margin="0,0,0,6" />
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="RSlider" Grid.Column="0" Minimum="3.5" Maximum="4.0" TickFrequency="0.01"
                    IsSnapToTickEnabled="True" ValueChanged="RSlider_ValueChanged" VerticalAlignment="Center" />
            <TextBox x:Name="RTextBox" Grid.Column="1" Style="{StaticResource MaterialTextBox}"
                     Margin="8,0,0,0" HorizontalContentAlignment="Center"
                     LostFocus="RTextBox_LostFocus" KeyDown="ParamTextBox_KeyDown" />
          </Grid>
          <TextBlock x:Name="X0Label" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
          <TextBlock x:Name="X0RangeHint" Style="{StaticResource BodySmall}" Margin="0,0,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="X0Slider" Grid.Column="0" Minimum="0.01" Maximum="0.99" TickFrequency="0.01"
                    IsSnapToTickEnabled="True" ValueChanged="X0Slider_ValueChanged" VerticalAlignment="Center" />
            <TextBox x:Name="X0TextBox" Grid.Column="1" Style="{StaticResource MaterialTextBox}"
                     Margin="8,0,0,0" HorizontalContentAlignment="Center"
                     LostFocus="X0TextBox_LostFocus" KeyDown="ParamTextBox_KeyDown" />
          </Grid>
          <CheckBox x:Name="DefaultFixedMsgBitLimitCheck" Margin="0,12,0,0"
                    Checked="DefaultFixedMsgBitLimitCheck_Changed"
                    Unchecked="DefaultFixedMsgBitLimitCheck_Changed" />
        </StackPanel>
      </Border>

      <Button x:Name="ResetButton" Style="{StaticResource TonalButton}" HorizontalAlignment="Center"
              Click="ResetButton_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;" Margin="0,0,8,0" />
          <TextBlock x:Name="ResetLabel" />
        </StackPanel>
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>
