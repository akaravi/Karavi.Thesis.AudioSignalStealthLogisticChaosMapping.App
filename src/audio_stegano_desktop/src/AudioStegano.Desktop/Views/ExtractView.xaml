<UserControl x:Class="AudioStegano.Desktop.Views.ExtractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" Padding="16,48,16,16">
      <StackPanel MaxWidth="720">
        <Border x:Name="ExtractCard" Style="{StaticResource MaterialCard}" Padding="20">
          <StackPanel>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E6;" FontSize="56"
                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="PickTitle" Style="{StaticResource SectionTitle}"
                       HorizontalAlignment="Center" Margin="0,12,0,16" TextAlignment="Center" />
            <StackPanel x:Name="BitLengthPanel">
              <TextBox x:Name="BitLengthBox" Style="{StaticResource LatinInputTextBox}" />
              <TextBlock x:Name="BitLengthHelper" Style="{StaticResource BodySmall}" Margin="0,8,0,16" />
            </StackPanel>
            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,12">
              <Button x:Name="PickButton" Style="{StaticResource FilledButton}" Click="PickButton_Click"
                      Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock x:Name="PickIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE838;" Margin="0,0,8,0" />
                  <TextBlock x:Name="PickLabel" />
                </StackPanel>
              </Button>
              <StackPanel x:Name="PlaybackPanel" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="PlayButton" Style="{StaticResource IconFilledButton}" Margin="0,0,8,0"
                        Click="PlayButton_Click">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="16" />
                </Button>
                <Button x:Name="PauseButton" Style="{StaticResource IconTonalButton}" Margin="0,0,8,0"
                        Click="PauseButton_Click" IsEnabled="False">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="16" />
                </Button>
                <Button x:Name="StopPlaybackButton" Style="{StaticResource IconTonalButton}" Margin="0,0,8,0"
                        Click="StopPlaybackButton_Click" IsEnabled="False">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="16" />
                </Button>
              </StackPanel>
            </WrapPanel>
            <Button x:Name="ExtractButton" Style="{StaticResource FilledButton}" Click="ExtractButton_Click"
                    HorizontalAlignment="Stretch" IsEnabled="False">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE785;" Margin="0,0,8,0" />
                <TextBlock x:Name="ExtractLabel" />
              </StackPanel>
            </Button>
            <ProgressBar x:Name="BusyBar" Height="22" Width="22" Margin="0,12,0,0"
                         HorizontalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextAlignment="Center"
                       Style="{StaticResource BodySmall}" />
          </StackPanel>
        </Border>

        <Border x:Name="ResultPanel" Style="{StaticResource ResultCard}" Margin="0,16,0,0"
                Visibility="Collapsed" Padding="20">
          <StackPanel>
            <!-- Hero -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
              <TextBlock x:Name="ResultHeaderIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;"
                         FontSize="40" Foreground="{DynamicResource PrimaryBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock x:Name="ResultTitle" Margin="0,10,0,0" Style="{StaticResource SectionTitle}"
                         FontSize="20" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                         HorizontalAlignment="Center" TextWrapping="Wrap" />
              <TextBlock x:Name="ResultSubtitle" Margin="0,6,0,0" Style="{StaticResource BodySmall}"
                         Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"
                         HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                         Visibility="Collapsed" />
            </StackPanel>

            <!-- Primary CTAs -->
            <WrapPanel x:Name="ResultActionsPanel" Margin="0,0,0,20" HorizontalAlignment="Center"
                       Visibility="Collapsed">
              <Button x:Name="SaveExtractedButton" Style="{StaticResource IconFilledButton}" Margin="0,0,8,8"
                      Click="SaveExtractedButton_Click" Visibility="Collapsed"
                      ToolTipService.ShowOnDisabled="True">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="16" />
              </Button>
              <Button x:Name="PlayExtractedButton" Style="{StaticResource TonalButton}" Margin="0,0,8,8"
                      Click="PlayExtractedButton_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,8,0" />
                  <TextBlock x:Name="PlayExtractedLabel" />
                </StackPanel>
              </Button>
              <Button x:Name="CopyButton" Style="{StaticResource FilledButton}" Margin="0,0,8,8"
                      Click="CopyButton_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" Margin="0,0,8,0" />
                  <TextBlock x:Name="CopyLabel" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <!-- Payload content -->
            <Border x:Name="ResultPayloadBlock" Background="{DynamicResource SurfaceVariantBrush}"
                    CornerRadius="16" Padding="14" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="ResultPayloadTitle" Style="{StaticResource SectionTitle}" FontSize="14"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}" FontSize="15" Visibility="Collapsed" />
                <Image x:Name="ResultImage" MaxHeight="220" Stretch="Uniform"
                       Visibility="Collapsed" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="16,8,16,0">
      <Button x:Name="NewExtractFab" Style="{StaticResource CircleFabPrimary}" Margin="0,0,8,0"
              Click="NewExtractFab_Click" ToolTipService.ShowOnDisabled="True">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70B;" FontSize="18" />
      </Button>
      <Button x:Name="HelpFab" Style="{StaticResource CircleFabSecondary}"
              Click="HelpFab_Click" ToolTipService.ShowOnDisabled="True">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE897;" FontSize="18" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
