<Window x:Class="AudioStegano.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AudioStegano.Desktop.Views"
        Title="نهان‌نگاری پیام در صوت"
        Height="780" Width="960"
        MinHeight="600" MinWidth="720"
        WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- AppBar — page destination title (Material 3 small top app bar) -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,4">
      <Grid Height="56">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"
                   HorizontalAlignment="Stretch" VerticalAlignment="Center"
                   TextAlignment="Left" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!-- Content + optional rail -->
    <Grid Grid.Row="1" x:Name="ContentHost">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="RailColumn" Width="0" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="NavRail" Grid.Column="0" Visibility="Collapsed"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
              Background="{DynamicResource SurfaceContainerBrush}" Width="88" Padding="0,12">
        <StackPanel x:Name="RailButtons" />
      </Border>

      <Grid Grid.Column="1">
        <views:EmbedView x:Name="EmbedPage" Visibility="Visible" />
        <views:ExtractView x:Name="ExtractPage" Visibility="Collapsed" />
        <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        <views:AboutView x:Name="AboutPage" Visibility="Collapsed" />
      </Grid>
    </Grid>

    <!-- Bottom navigation (narrow) -->
    <Border x:Name="BottomNav" Grid.Row="2" Background="{DynamicResource SurfaceContainerBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
      <UniformGrid x:Name="BottomNavGrid" Rows="1" Columns="4" />
    </Border>

    <!-- Full-window blocking busy overlay -->
    <Border x:Name="GlobalBusyOverlay" Grid.RowSpan="3" Visibility="Collapsed"
            Background="#7A000000" Panel.ZIndex="200" IsHitTestVisible="True">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource SurfaceBrush}" CornerRadius="20"
              Padding="28,24" MinWidth="220" MaxWidth="320"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
          <ProgressBar Width="40" Height="40" IsIndeterminate="True"
                       HorizontalAlignment="Center" />
          <TextBlock x:Name="GlobalBusyMessage" Margin="0,16,0,0"
                     TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
