<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Soft UI / security-blue light theme (parity with Flutter AppBrandColors) -->
  <Color x:Key="BgColor">#FFF0F9FF</Color>
  <Color x:Key="SurfaceColor">#FFF8FBFF</Color>
  <Color x:Key="SurfaceContainerColor">#FFE0F2FE</Color>
  <Color x:Key="SurfaceVariantColor">#FFBAE6FD</Color>
  <Color x:Key="TextColor">#FF0C4A6E</Color>
  <Color x:Key="MutedColor">#FF475569</Color>
  <Color x:Key="BorderColor">#FFCBD5E1</Color>
  <Color x:Key="PrimaryColor">#FF0369A1</Color>
  <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
  <Color x:Key="PrimaryContainerColor">#FFE0F2FE</Color>
  <Color x:Key="OnPrimaryContainerColor">#FF0C4A6E</Color>
  <Color x:Key="SecondaryContainerColor">#FFF0F9FF</Color>
  <Color x:Key="ErrorColor">#FFB91C1C</Color>
  <Color x:Key="OnErrorContainerColor">#FF410E0B</Color>
  <Color x:Key="ErrorContainerColor">#FFFEE2E2</Color>
  <Color x:Key="SuccessColor">#FF15803D</Color>
  <Color x:Key="NavIndicatorColor">#FFE0F2FE</Color>
  <Color x:Key="ChartStegoColor">#FF0EA5E9</Color>
  <!-- Semantic icon accents — role-collapsed (Flutter AppIconAccents) -->
  <Color x:Key="IconEmbedColor">#FF0C4A6E</Color>
  <Color x:Key="IconExtractColor">#FF0F766E</Color>
  <Color x:Key="IconSettingsColor">#FFB45309</Color>
  <Color x:Key="IconAboutColor">#FF0C4A6E</Color>
  <Color x:Key="IconHelpColor">#FF0369A1</Color>
  <Color x:Key="IconCreateColor">#FF15803D</Color>
  <Color x:Key="IconVerifyColor">#FF15803D</Color>
  <Color x:Key="IconShareColor">#FF0369A1</Color>
  <Color x:Key="IconSaveColor">#FF0C4A6E</Color>
  <Color x:Key="IconCopyColor">#FF334155</Color>
  <Color x:Key="IconGithubColor">#FF334155</Color>
  <Color x:Key="IconThesisColor">#FF0C4A6E</Color>
  <Color x:Key="IconWebColor">#FF0369A1</Color>
  <Color x:Key="IconCompanyColor">#FF0F766E</Color>
  <Color x:Key="IconPhoneColor">#FF15803D</Color>
  <Color x:Key="IconEmailColor">#FFB91C1C</Color>
  <Color x:Key="IconCreateContainerColor">#2415803D</Color>
  <Color x:Key="IconHelpContainerColor">#240369A1</Color>
  <Color x:Key="IconVerifyContainerColor">#2415803D</Color>
  <Color x:Key="IconShareContainerColor">#240369A1</Color>
  <Color x:Key="IconCopyContainerColor">#24334155</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
  <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
  <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
  <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />
  <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainerColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="NavIndicatorBrush" Color="{StaticResource NavIndicatorColor}" />
  <SolidColorBrush x:Key="ChartStegoBrush" Color="{StaticResource ChartStegoColor}" />
  <SolidColorBrush x:Key="IconEmbedBrush" Color="{StaticResource IconEmbedColor}" />
  <SolidColorBrush x:Key="IconExtractBrush" Color="{StaticResource IconExtractColor}" />
  <SolidColorBrush x:Key="IconSettingsBrush" Color="{StaticResource IconSettingsColor}" />
  <SolidColorBrush x:Key="IconAboutBrush" Color="{StaticResource IconAboutColor}" />
  <SolidColorBrush x:Key="IconHelpBrush" Color="{StaticResource IconHelpColor}" />
  <SolidColorBrush x:Key="IconCreateBrush" Color="{StaticResource IconCreateColor}" />
  <SolidColorBrush x:Key="IconVerifyBrush" Color="{StaticResource IconVerifyColor}" />
  <SolidColorBrush x:Key="IconShareBrush" Color="{StaticResource IconShareColor}" />
  <SolidColorBrush x:Key="IconSaveBrush" Color="{StaticResource IconSaveColor}" />
  <SolidColorBrush x:Key="IconCopyBrush" Color="{StaticResource IconCopyColor}" />
  <SolidColorBrush x:Key="IconGithubBrush" Color="{StaticResource IconGithubColor}" />
  <SolidColorBrush x:Key="IconThesisBrush" Color="{StaticResource IconThesisColor}" />
  <SolidColorBrush x:Key="IconWebBrush" Color="{StaticResource IconWebColor}" />
  <SolidColorBrush x:Key="IconCompanyBrush" Color="{StaticResource IconCompanyColor}" />
  <SolidColorBrush x:Key="IconPhoneBrush" Color="{StaticResource IconPhoneColor}" />
  <SolidColorBrush x:Key="IconEmailBrush" Color="{StaticResource IconEmailColor}" />
  <SolidColorBrush x:Key="IconCreateContainerBrush" Color="{StaticResource IconCreateContainerColor}" />
  <SolidColorBrush x:Key="IconHelpContainerBrush" Color="{StaticResource IconHelpContainerColor}" />
  <SolidColorBrush x:Key="IconVerifyContainerBrush" Color="{StaticResource IconVerifyContainerColor}" />
  <SolidColorBrush x:Key="IconShareContainerBrush" Color="{StaticResource IconShareContainerColor}" />
  <SolidColorBrush x:Key="IconCopyContainerBrush" Color="{StaticResource IconCopyContainerColor}" />
</ResourceDictionary>
