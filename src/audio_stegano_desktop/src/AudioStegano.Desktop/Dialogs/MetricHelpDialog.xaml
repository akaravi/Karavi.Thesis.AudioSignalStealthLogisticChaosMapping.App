<Window x:Class="AudioStegano.Desktop.Dialogs.MetricHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SurfaceBrush}">
  <Border Padding="24" CornerRadius="16">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="22"
                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="TitleText" Margin="10,0,0,0" Style="{StaticResource SectionTitle}"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
      <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="BodyText" Style="{StaticResource BodySmall}" TextWrapping="Wrap"
                   LineHeight="20" />
      </ScrollViewer>
      <Button x:Name="OkButton" Style="{StaticResource FilledButton}" Margin="0,20,0,0"
              MinWidth="120" HorizontalAlignment="Stretch" Click="OkButton_Click" />
    </StackPanel>
  </Border>
</Window>
