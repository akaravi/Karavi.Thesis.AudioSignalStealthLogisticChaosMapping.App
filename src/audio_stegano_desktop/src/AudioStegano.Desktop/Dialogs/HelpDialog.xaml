<Window x:Class="AudioStegano.Desktop.Dialogs.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Manual"
        Width="520" Height="640"
        MinWidth="400" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Padding="20,16,20,12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <Border Width="44" Height="44" CornerRadius="14"
                Background="{DynamicResource PrimaryContainerBrush}">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE736;" FontSize="22"
                     Foreground="{DynamicResource PrimaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="TitleText" Margin="12,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,12">
      <StackPanel x:Name="SectionsPanel" />
    </ScrollViewer>
    <Border Grid.Row="2" Padding="20,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Button x:Name="CloseButton" Style="{StaticResource FilledButton}" HorizontalAlignment="Stretch"
              Click="CloseButton_Click" />
    </Border>
  </Grid>
</Window>
